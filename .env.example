# Copy to .env. Empty values are treated as unset.

# mock: every source answers from apps/api/fixtures. live: call the real APIs.
CARCHECK_MODE=mock
MOCK_LATENCY_MS=400
LOG_LEVEL=info
SOURCE_TIMEOUT_MS=10000
# Only needed if the browser calls the API on a different origin from the web app.
CORS_ORIGIN=

# DVLA Vehicle Enquiry Service
DVLA_API_KEY=

# DVSA MOT History API (all four come from the DVSA onboarding email)
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_TOKEN_URL=

# RDW open data: optional Socrata app token for higher rate limits
RDW_APP_TOKEN=

# Name of the existing reverse proxy's Docker network on the server
PROXY_NETWORK=proxy

# Postgres for the car check database (a separate `carcheck` database and role in the existing
# server Postgres). Leave empty to keep everything in memory.
DATABASE_URL=
# Apply migrations on startup
DB_MIGRATE=true
# Reuse each source's stored answer while fresh; CACHE_TTL_HOURS overrides every source's TTL
CACHE_ENABLED=true
CACHE_TTL_HOURS=
