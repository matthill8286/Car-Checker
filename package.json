{
  "name": "car-check",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @carcheck/core build && pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @carcheck/core build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:client": "pnpm --filter @carcheck/core build && pnpm --filter @carcheck/api openapi && pnpm --filter @carcheck/web gen:client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
