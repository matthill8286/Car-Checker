# Car check's own proxy. The box's public edge Caddy terminates HTTPS for
# carcheck.weareimpakt.com and forwards here over the stack's Docker network, so this one
# serves plain HTTP on 8080 and publishes no port on the host.
{
	auto_https off
	admin off
}

:8080 {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode zstd gzip
	# One login for the whole site.
	basic_auth {
		{$CARCHECK_AUTH_USER} {$CARCHECK_AUTH_HASH}
	}
	# Check progress streams as server-sent events; Caddy flushes those as they arrive.
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
	log {
		output stdout
		format json
	}
}
