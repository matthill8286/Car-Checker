# The box's ~/carcheck/.env. The deploy workflow writes it from the CARCHECK_ENV secret on every
# deploy, so edit the secret, not the file. Never commit a filled-in copy.

# ── Address and login ───────────────────────────────────────────────────────
CARCHECK_DOMAIN=carcheck.impkt-apps.duckdns.org
ACME_EMAIL=
# The token on duckdns.org, used to prove the name for the certificate.
DUCKDNS_TOKEN=
CARCHECK_AUTH_USER=matt
# docker run --rm caddy:2.8-alpine caddy hash-password  (keep the single quotes: it contains $)
CARCHECK_AUTH_HASH=''

# ── Database (this stack's own Postgres container) ──────────────────────────
# Letters and digits only.
POSTGRES_PASSWORD=

# ── Sources ─────────────────────────────────────────────────────────────────
CARCHECK_MODE=live
LOG_LEVEL=info
DVLA_API_KEY=
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_TOKEN_URL=

# Weekly DVLA/DVSA keep-alive is on by default; set REFRESH_CRON to re-check saved cars.
KEEPALIVE_CRON=0 6 * * 1
REFRESH_CRON=
